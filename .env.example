# GMS 안내의 OpenAI 호환 예제에서 세 값을 확인하세요. 실제 키를 공유하지 마세요.
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
GMS_MODEL=gpt-5.4-nano

# 기본값 local: 임베딩은 내 PC에서 계산하며 GMS 임베딩 권한이 필요 없습니다.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# openai 호환 임베딩을 사용할 때만 아래 값을 채우고 provider를 openai로 변경합니다.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 수집기 식별용입니다. 선택 사항입니다. 연락처를 제공한다면 실제 이메일을 적으세요.
COLLECTOR_CONTACT=
